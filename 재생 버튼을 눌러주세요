.dwrap{position:relative}
#ambv{max-height:max(140px,calc((100vh - 360px)*.56))}
#ambv{max-height:max(140px,calc((100dvh - 360px)*.56))}
#duckv{max-height:max(110px,calc((100vh - 360px)*.44))}
#duckv{max-height:max(110px,calc((100dvh - 360px)*.44))}
/* 그림판 귀퉁이의 소리 켬·끔 단추 (연보라) */
.sndb{position:absolute;top:8px;right:8px;padding:4px 12px;border:1px solid var(--sub-bd);border-radius:999px;background:var(--sub-bg);color:var(--sub-tx);font-size:.85rem;font-weight:700;cursor:pointer}
.sndb.on{background:var(--sub);border-color:var(--sub-tx);color:var(--on-sub)}
@media (max-width:820px){.duo{grid-template-columns:1fr;grid-template-rows:none}.duo>*{grid-column:1!important;grid-row:auto!important}.duo svg,.duo svg{height:26vh}.duo>.rh{margin-top:10px}}
/* 생각해 보기: 정식 사이트(eclipses.html 심화 질문, luminosity.html)와 같은 형식
   상자 없이 한 줄에 [꼬리표(남색)] 질문 [답 보기(남색 테두리)] → 누르면 팝업에 질문과 답 */
.note.ask{margin:10px 0 0;padding:0;border-radius:0;background:none;display:flex;align-items:center;flex-wrap:wrap;gap:8px 10px;font-size:.95rem}
.note.ask p{margin:0;font-weight:600}
.ask2{margin-top:6px!important}
.tag{display:inline-block;flex:none;padding:2px 10px;border-radius:999px;background:var(--acc);color:var(--on-acc);font-size:.8rem;font-weight:700;letter-spacing:.02em;white-space:nowrap}
.open-think{padding:4px 12px;font-size:.85rem;font-weight:700;border:1px solid var(--acc);border-radius:10px;background:var(--bg);color:var(--acc);cursor:pointer;flex:none;font-family:inherit}
.open-think:hover{background:var(--card)}
.ov{position:fixed;inset:0;z-index:20;background:rgba(10,14,25,.55);display:flex;align-items:center;justify-content:center;padding:16px}
.ov[hidden]{display:none}
.think{background:var(--bg);color:var(--fg);width:min(680px,100%);max-height:100%;overflow:auto;padding:14px 18px;border-radius:14px;box-shadow:0 10px 40px rgba(0,0,0,.35)}
.think-h{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}
.think-t{display:flex;align-items:center;gap:8px;color:var(--acc);font-size:1rem}
.think .x{flex:none;font-size:.85rem;background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:3px 10px;cursor:pointer;color:var(--fg);font-family:inherit}
.think .ans{margin:0 0 8px;font-size:1rem;font-weight:700}
.think .exp{margin:0;font-size:.93rem;line-height:1.6}
.think .exp+.exp{margin-top:6px}
/* 세 사람의 생각 비교 표 */
.cmp{width:100%;border-collapse:collapse;font-size:.9rem;line-height:1.45}
.cmp th,.cmp td{border:1px solid var(--bd);padding:7px 9px;text-align:left;vertical-align:top}
.cmp thead th{background:var(--acc-bg);color:var(--acc);text-align:center}
.cmp tbody th{background:var(--card);white-space:nowrap}
</style>
