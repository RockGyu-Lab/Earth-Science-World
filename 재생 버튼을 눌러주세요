<script>
// 학습 메뉴 탭 (evolution.html과 같은 방식: 왼쪽·오른쪽 화살표 키로도 이동)
const TABS=[tab1,tab2,tab3,tab4],PANES=[p1,p2,p3,p4];
function openTab(i){if(typeof dStop=="function")dStop();TABS.forEach((t,j)=>{t.setAttribute('aria-selected',i==j);t.tabIndex=i==j?0:-1;PANES[j].hidden=i!=j});
 PANES[i].classList.remove('enter');void PANES[i].offsetWidth;PANES[i].classList.add('enter');
 // 숨겨져 있던 그림판은 글자 배경 상자를 다시 그리기 위해 새로 그림
 if(i==1&&hcur=='s')dDraw()}
TABS.forEach((t,i)=>{t.onclick=()=>openTab(i);t.onkeydown=e=>{if(e.key=='ArrowRight'||e.key=='ArrowLeft'){const j=(i+(e.key=='ArrowRight'?1:TABS.length-1))%TABS.length;TABS[j].focus();openTab(j)}}});

// ---- 공통: 그리기 도구 ----
const NS="http://www.w3.org/2000/svg";
function mk(tag,at,par){const e=document.createElementNS(NS,tag);for(const k in at)e.setAttribute(k,at[k]);if(par)par.appendChild(e);return e}
function txt(s,at,par){const e=mk('text',at,par);e.textContent=s;return e}
function rng(seed){return()=>{seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function arrow(x1,y1,x2,y2,c,m,par){return mk('line',{x1,y1,x2,y2,stroke:c,'stroke-width':3,'marker-end':`url(#${m})`},par)}
function label(s,x,y,par,anchor='start',col='#e8ecff',size=19){const g=mk('g',{},par);const t=txt(s,{x,y,'text-anchor':anchor,fill:col,'font-size':size,'font-weight':600},g);
 const b=t.getBBox?t.getBBox():null;if(b&&b.width){g.insertBefore(mk('rect',{x:b.x-6,y:b.y-3,width:b.width+12,height:b.height+6,rx:6,fill:'#0b1026',opacity:.8}),t)}return g}
// 별 배치: 반지름 SR인 둥근 영역 안에 거의 고르게(조금씩 불규칙하게) 놓인 별들 (처음에 멈춰 있음)
const SR=120,SSP=22;
function makeStars(){const r=rng(5),a=[];
 for(let j=-6;j<=6;j++)for(let i=-6;i<=6;i++){const x=i*SSP+(r()-.5)*18,y=j*SSP+(r()-.5)*18;if(x*x+y*y<=SR*SR)a.push({x,y,vx:0,vy:0,m:1})}
 return a}
const fRad=m=>2.6*Math.pow(m,.4);

// ==== 왼쪽: 벤틀리의 질문 (그림판 bv) ====
// 이웃한 별끼리 먼저 작은 덩어리를 이루고, 덩어리들이 가운데로 모이며 합쳐져 결국 하나가 됨
const BC={x:200,y:182},FG=600,FEPS2=16;
let BS=[],bTime=0,bDone=false,braf=0,bG=null;
function bStop(){cancelAnimationFrame(braf);braf=0;bplay.textContent='▶ 재생'}
function finStep(dt){const n=BS.length,ax=new Float64Array(n),ay=new Float64Array(n);
 for(let i=0;i<n;i++)for(let j=i+1;j<n;j++){const a=BS[i],b=BS[j],dx=b.x-a.x,dy=b.y-a.y,r2=dx*dx+dy*dy+FEPS2,f=FG/(r2*Math.sqrt(r2));
  ax[i]+=f*b.m*dx;ay[i]+=f*b.m*dy;ax[j]-=f*a.m*dx;ay[j]-=f*a.m*dy}
 BS.forEach((s,i)=>{s.vx+=ax[i]*dt;s.vy+=ay[i]*dt;s.x+=s.vx*dt;s.y+=s.vy*dt});
 // 아주 가까워진 별은 하나로 합쳐짐 (질량과 운동량은 보존)
 for(let i=0;i<BS.length;i++)for(let j=i+1;j<BS.length;j++){const a=BS[i],b=BS[j];
  if(Math.hypot(b.x-a.x,b.y-a.y)<.8*(fRad(a.m)+fRad(b.m))){const m=a.m+b.m;
   a.x=(a.x*a.m+b.x*b.m)/m;a.y=(a.y*a.m+b.y*b.m)/m;a.vx=(a.vx*a.m+b.vx*b.m)/m;a.vy=(a.vy*a.m+b.vy*b.m)/m;a.m=m;BS.splice(j,1);j=i}}}
function bDraw(){if(bG)bG.remove();bG=mk('g',{},bv);
 mk('circle',{cx:BC.x,cy:BC.y,r:SR+14,fill:'none',stroke:'#4a5694','stroke-dasharray':'6 6'},bG);
 BS.forEach(s=>mk('circle',{cx:BC.x+s.x,cy:BC.y+s.y,r:fRad(s.m),fill:s.m>1?'#fff4d6':'#dfe5ff'},bG));
 if(bTime==0){
  // 처음 화면에만: 몇몇 별(가로·세로·대각선 방향)이 받는 힘. 가운데를 향하고, 가장자리일수록 큼
  [0,1,2,3,4,5,6,7].forEach(k=>{const a=k*Math.PI/4;[50,100].forEach(d=>{const px=BC.x+Math.cos(a)*d,py=BC.y+Math.sin(a)*d,L=d*.24;
   arrow(px-Math.cos(a)*4,py-Math.sin(a)*4,px-Math.cos(a)*(4+L),py-Math.sin(a)*(4+L),'#ffb066','ag',bG)})});
  label('별들이 서로 끌어당김',200,28,bG,'middle','#ffb066')}
 else label(bDone?'하나의 큰 덩어리가 됨':'뭉치면서 가운데로 모임',200,28,bG,'middle','#ffd76b');
 label('단순화한 모형: 부딪힌 별은 합쳐진다고 가정',8,330,bG,'start','#a9b1cc',15)}
function bLoop(){for(let k=0;k<4;k++)finStep(1/240);bTime+=1/60;
 if(BS.length==1||bTime>15){bDone=BS.length==1;bDraw();bStop();
  bhint.textContent='별들이 한 점으로 모입니다.';return}
 bDraw();braf=requestAnimationFrame(bLoop)}
function bInit(){bStop();BS=makeStars();bTime=0;bDone=false;bDraw();bhint.textContent='재생 버튼을 눌러주세요.'}
bplay.onclick=()=>{if(braf){bStop();return}if(BS.length==1||bTime>15){BS=makeStars();bTime=0;bDone=false}bplay.textContent='⏸ 멈춤';bhint.textContent='';braf=requestAnimationFrame(bLoop)};
breset.onclick=bInit;
bInit();

// ==== 오른쪽: 세 과학자의 해결 아이디어 (그림판 sv) ====
const SN={
 '':'<p>벤틀리의 질문처럼 별들이 한곳에 모이지 않으려면 어떻게 해야 할까요? 위에서 세 과학자 중 한 사람을 골라 그 사람의 생각을 알아보세요.</p>',
 n:'<div class="nh">뉴턴의 해결 아이디어 <span class="ex">· 무한하고 균일한 정적 우주 (1692년)</span></div><p>우주가 끝없이 넓고 별이 균일하게 퍼져 있다면, 어느 별이든 모든 방향에서 같은 크기의 힘으로 당겨져 힘의 평형을 이룬다. 그래서 별들은 한곳으로 모이지 않는다. <span class="aside">(속마음: 거울 위에 바늘을 세우는 것처럼 아슬아슬한 평형이라, 사실 내 답변이 마음에 들지는 않아.)</span></p>',
 e:'<div class="nh">아인슈타인의 해결 아이디어 <span class="ex">· 우주 상수로 지킨 정적 우주 (1917년)</span></div><p>중력만 있으면 우주는 그대로 있을 수 없다. 그래서 중력과 반대로 밀어내는 효과를 내는 <b>우주 상수</b>를 식에 넣어, 중력과 균형을 이루는 정적 우주를 만들었다. <span class="aside">(속마음: 우주가 팽창하거나 수축하며 변한다니, 그건 도저히 믿을 수 없어!)</span></p>',
 f:'<div class="nh">프리드만의 해결 아이디어 <span class="ex">· 팽창하는 우주 (1922년)</span></div><p>아인슈타인의 방정식을 풀어 우주가 팽창하거나 수축할 수 있음을 보였다. 우주가 <b>팽창하고 있다면</b> 중력은 팽창을 늦출 뿐, 별들이 한곳으로 모이지 않는다. <span class="aside">(속마음: 방정식이 허락하는데, 우주가 꼭 멈춰 있어야 할 이유가 있을까?)</span></p>'};
const RC={x:360,y:172};
let who='',raf=0,nG=null,ES=[];
function stopAll(){cancelAnimationFrame(raf);raf=0;splay.textContent='▶ 재생'}
function pick(v){stopAll();who=v;psel.querySelectorAll('button').forEach(b=>b.classList.toggle('on',b.dataset.v==v));
 snote.innerHTML=SN[v];sv.innerHTML='';nG=null;splay.disabled=sreset.disabled=!v;({'':zInit,n:nInit,e:eInit,f:fInit})[v]()}
psel.addEventListener('click',e=>{const b=e.target.closest('button');if(b)pick(b.dataset.v)});
splay.onclick=()=>{if(raf){stopAll();return}({n:nPlay,e:ePlay,f:fPlay})[who]()};
sreset.onclick=()=>pick(who);

// 아직 아무도 고르지 않았을 때
function zInit(){nG=mk('g',{},sv);
 txt('위의 단추에서 세 과학자 중 한 사람을 골라 보세요',{x:360,y:175,'text-anchor':'middle',fill:'#a9b1cc','font-size':19,'font-weight':600},nG);
 shint.textContent=''}

// ---- 뉴턴: 무한하고 균일한 우주. 별을 무늬(pattern)로 끝없이 채움. 재생해도 별들은 움직이지 않음 ----
const ISP=40;
let selI=0,selJ=0;
// 그림판에서 실제로 보이는 영역 (viewBox 좌표)
function visBox(){const m=sv.getScreenCTM(),r=sv.getBoundingClientRect();if(!m||!r.width)return{x:0,y:0,w:720,h:330};const i=m.inverse(),a=new DOMPoint(r.left,r.top).matrixTransform(i),b=new DOMPoint(r.right,r.bottom).matrixTransform(i);return{x:a.x,y:a.y,w:b.x-a.x,h:b.y-a.y}}
function infDraw(){if(nG)nG.remove();nG=mk('g',{},sv);
 const d=mk('defs',{},nG);
 // 멀리 있는 별(작고 어두움)을 한 겹 더 깔아 깊이감을 줌
 const p2=mk('pattern',{id:'lat2',patternUnits:'userSpaceOnUse',width:ISP,height:ISP,x:RC.x+ISP/2,y:RC.y+ISP/2},d);
 [[0,0],[ISP,0],[0,ISP],[ISP,ISP]].forEach(([x,y])=>mk('circle',{cx:x,cy:y,r:1.4,fill:'#8f9ad0',opacity:.55},p2));
 const p1=mk('pattern',{id:'lat1',patternUnits:'userSpaceOnUse',width:ISP,height:ISP,x:RC.x-ISP/2,y:RC.y-ISP/2},d);
 mk('circle',{cx:ISP/2,cy:ISP/2,r:3,fill:'#dfe5ff'},p1);
 // 그림판이 화면 비율 때문에 좌우·위아래로 넓어져도 빈 곳이 없도록 무늬를 넉넉히 넓게 깖
 const V=visBox();
 mk('rect',{x:V.x-50,y:V.y-50,width:V.w+100,height:V.h+100,fill:'url(#lat2)'},nG);
 mk('rect',{x:V.x-50,y:V.y-50,width:V.w+100,height:V.h+100,fill:'url(#lat1)'},nG);
 // 고른 별: 모든 방향에서 같은 크기로 당겨짐
 const cx=RC.x+selI*ISP,cy=RC.y+selJ*ISP;
 mk('circle',{cx,cy,r:7,fill:'#ffd76b'},nG);
 for(let k=0;k<8;k++){const a=k*Math.PI/4,L=26;arrow(cx+Math.cos(a)*10,cy+Math.sin(a)*10,cx+Math.cos(a)*(10+L),cy+Math.sin(a)*(10+L),'#ffd76b','ay',nG)}
 label('노란 별: 모든 방향에서 같은 크기로 당겨짐 → 힘의 평형',360,28,nG,'middle','#ffd76b');
 // 화면 가장자리: 별이 바깥으로 끝없이 이어짐
 label('◀ 끝없이',V.x+12,177,nG,'start','#cbd3ff',17);label('끝없이 ▶',V.x+V.w-12,177,nG,'end','#cbd3ff',17);
 label('▼ 끝없이',360,320,nG,'middle','#cbd3ff',17)}
function nInit(){selI=0;selJ=0;infDraw();shint.textContent='아무 별이나 눌러 보세요.'}
function nPlay(){shint.textContent='시간이 지나도 별들은 움직이지 않습니다. 모든 별이 힘의 평형을 이루어 우주는 변하지 않습니다.'}
// 화면 크기가 바뀌면 별 무늬를 다시 깖
addEventListener('resize',()=>{if(who=='n')infDraw()});
// 별을 누르면 그 별을 고름 (가장 가까운 별)
sv.addEventListener('click',e=>{if(who!='n')return;const m=sv.getScreenCTM();if(!m)return;
 const pt=new DOMPoint(e.clientX,e.clientY).matrixTransform(m.inverse());
 selI=Math.round((pt.x-RC.x)/ISP);selJ=Math.round((pt.y-RC.y)/ISP);infDraw();
 shint.textContent='이 별도 모든 방향에서 같은 크기로 당겨집니다. 이제 재생 버튼을 눌러주세요.'});

// 범례 한 줄: 화살표 + 글
function legend(y,c,m,s,par){arrow(14,y,50,y,c,m,par);label(s,58,y+5,par,'start','#e8ecff',16)}

// ---- 아인슈타인: 별마다 안쪽으로 당기는 중력과 우주 상수에 의한 척력의 크기가 같음 (둘 다 가운데에서 멀수록 큼) ----
function eInit(){ES=makeStars();eqDraw();shint.textContent='재생 버튼을 눌러주세요.'}
