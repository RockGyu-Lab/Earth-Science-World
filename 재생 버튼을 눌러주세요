/* 탭을 바꿀 때 내용이 살짝 떠오르며 나타남 */
@keyframes enter{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.enter{animation:enter .28s ease-out}
@media (prefers-reduced-motion:reduce){.enter{animation:none}}
/* 그림판: 패드에서도 한 화면에 들어오도록 높이를 화면 높이에 맞춰 제한 */
svg{width:100%;height:auto;display:block;border-radius:14px;background:#0b1026;box-shadow:0 0 0 1px var(--frame)}
section svg{max-height:max(300px,calc(100vh - 300px))}
section svg{max-height:max(300px,calc(100dvh - 300px))}
@media (max-width:640px){.tabs button{flex-basis:40%}}
