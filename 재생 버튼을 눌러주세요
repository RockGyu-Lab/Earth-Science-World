/* ① 정적 우주와 팽창 우주: 왼쪽 1/3 벤틀리의 질문(문제) | 오른쪽 2/3 세 과학자의 해결 아이디어(골라 보기)
   두 칸의 설명·그림·조작 줄이 같은 높이에 오도록 격자로 배치. 좁은 화면에서는 위아래로 쌓음 */
.duo{display:grid;grid-template-columns:2fr 3fr;grid-template-rows:auto 1fr auto auto;gap:8px 12px;align-items:start}
.duo>.lq{grid-column:1;grid-row:1/3;align-self:stretch}
.duo>.rh{grid-column:2;grid-row:1/3;align-self:stretch}
#snote{margin-top:8px;padding-top:6px;border-top:1px solid var(--bd)}
.duo>.lv{grid-column:1;grid-row:3}
.duo>.rv{grid-column:2;grid-row:3}
.duo>.lc{grid-column:1;grid-row:4;align-self:stretch}
.duo>.rc{grid-column:2;grid-row:4;align-self:stretch}
.duo .note,.duo .ctl{margin:0}
.duo .note p{margin:2px 0 0}
/* 벤틀리의 질문: 줄 쳐진 편지 모양 (본문 끝에 보낸 사람을 오른쪽으로) */
/* 편지지: 크림색 종이, 파란 줄, 왼쪽 붉은 여백선 */
:root{--paper:#fffaee;--pline:#c9d8ee;--pmar:#eeaaaa;--pbd:#eadfc6}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--paper:#29271f;--pline:#3c475c;--pmar:#7a4040;--pbd:#3d3a2e}}
:root[data-theme="dark"]{--paper:#29271f;--pline:#3c475c;--pmar:#7a4040;--pbd:#3d3a2e}
.duo>.lq{display:flex;flex-direction:column;padding:10px 14px 8px 40px;background:linear-gradient(90deg,transparent 27px,var(--pmar) 27px 28px,transparent 28px 30px,var(--pmar) 30px 31px,transparent 31px),var(--paper);border:1px solid var(--pbd);border-radius:6px;box-shadow:0 2px 6px rgba(60,40,0,.12)}
.lq .body{flex:1;margin:4px 0 0;line-height:1.75;background:repeating-linear-gradient(transparent 0 calc(1.75em - 1px),var(--pline) calc(1.75em - 1px) 1.75em)}
.aside{opacity:.72;font-size:.9em}
.lq .from{display:block;text-align:right;padding-right:.5em}
.srow{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px}
/* 왼쪽·오른쪽 그림판의 높이를 똑같이 맞춤 (화면 높이에 따라 정하고, 그림은 가운데에 맞춰 그림) */
.duo svg{height:min(270px,max(190px,calc(100vh - 508px)));max-height:none}
.duo svg{height:min(270px,max(190px,calc(100dvh - 508px)))}
.pb:disabled{opacity:.4;cursor:default}
/* ② 도플러 효과: 작은 학습 화면 단추 + 설명 + 그림판 + 조작 줄 */
#hnote p{margin:2px 0 0}
#hv{max-height:max(240px,calc(100vh - 365px))}
#hv{max-height:max(240px,calc(100dvh - 365px))}
/* 소리의 도플러 효과: 위아래 두 그림판이 함께 화면 높이에 맞춰 줄어듦 */
