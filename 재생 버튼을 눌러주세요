#p1 .ctl{min-height:60px}
#p1 .lc .hint{flex-basis:120px}
.ctl[hidden],.seg[hidden]{display:none}
.unit{font-size:.85rem;opacity:.75}
.hint{flex:1 1 260px;font-size:.86rem;line-height:1.45}
.pb{padding:6px 14px;border:1px solid var(--acc);border-radius:10px;background:var(--acc);color:var(--on-acc);font-size:.9rem;font-weight:700;cursor:pointer;flex:none}
/* 탭 안에서 고르는 단추: 라벤더(연보라) */
.subtabs{display:flex;flex-wrap:wrap;gap:6px}
.subtabs button{padding:5px 16px;border:1px solid var(--sub-bd);border-radius:999px;background:var(--sub-bg);color:var(--sub-tx);font-size:.9rem;font-weight:700;cursor:pointer}
