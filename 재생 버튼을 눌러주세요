.seg{display:flex;align-items:center;gap:8px;font-size:.9rem;font-weight:700}
.seg .bs{display:flex;flex-wrap:wrap;border:1px solid var(--sub-bd);border-radius:10px;overflow:hidden}
.seg .bs button{padding:6px 11px;border:0;background:var(--sub-bg);color:var(--sub-tx);font-size:.88rem;font-weight:600;cursor:pointer}
.seg .bs button+button{border-left:1px solid var(--sub-bd)}
.seg .bs button.on{background:var(--sub);color:var(--on-sub);font-weight:700}
.sl{display:flex;align-items:center;gap:8px;font-size:.9rem;font-weight:700}
